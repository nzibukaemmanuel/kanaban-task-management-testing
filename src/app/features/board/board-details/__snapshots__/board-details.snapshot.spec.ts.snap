exports[`BoardDetails columns (snapshots) renders a single column when a status filter is set 1`] = `
<div
  class="board-columns"
>
  <section
    aria-label="Doing tasks"
    class="board-column"
  >
    <h2
      class="board-column__heading"
    >
      <span
        aria-hidden="true"
        class="board-column__dot"
        data-status="doing"
      />
       Doing (2) 
    </h2>
    <ul
      class="board-column__list"
    >
      <li>
        <a
          class="task-card"
          href="/tasks/design-review"
        >
          <span
            class="task-card__title"
          >
            Design review
          </span>
          <span
            class="task-card__meta"
          >
             1 of 3 subtasks 
          </span>
          
        </a>
      </li>
      <li>
        <a
          class="task-card"
          href="/tasks/beta-testing"
        >
          <span
            class="task-card__title"
          >
            Run beta testing
          </span>
          <span
            class="task-card__meta"
          >
             2 of 3 subtasks 
          </span>
          
        </a>
      </li>
      
      
    </ul>
  </section>
  
  
</div>
`;

